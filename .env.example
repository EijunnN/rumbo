# Copia este archivo a .env y completa los valores.

# Genera uno con: openssl rand -base64 48   (o: mix phx.gen.secret)
SECRET_KEY_BASE=

# Contraseña del Postgres interno del compose
POSTGRES_PASSWORD=

# Dominio público de la API (para URLs generadas). Ej: tracking.miapp.com
PHX_HOST=localhost

# Puerto del host donde se expone la API
RUMBO_PORT=4000

# Restringir orígenes de WebSocket (separados por espacio). Vacío = abierto.
# CHECK_ORIGIN=https://miapp.com https://admin.miapp.com
